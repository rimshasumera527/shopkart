# ── Backend Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server
PORT=8080

# MongoDB — use your Atlas connection string or local URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# MONGO_URI=mongodb://localhost:27017/shopkart   # for local dev

# (Optional) Override DNS servers if Atlas SRV resolution fails on your network
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8

# JWT — use a long, random string in production
JWT_SECRET=replace_with_a_strong_random_secret_key

# Razorpay — get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
